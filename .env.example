# Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit file .env.
# Hanya dipakai oleh api/translate.ts (Mode B). Frontend tidak boleh membaca variabel ini.

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=4000

# TTS neural (api/tts.ts). Azure Speech tier gratis F0: 0,5 juta karakter/bulan.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=id-ID-GadisNeural
