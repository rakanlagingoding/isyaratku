# Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit file .env.
# Hanya dipakai oleh api/translate.ts (Mode B). Frontend tidak boleh membaca variabel ini.

# Provider: Google Gemini (DECISIONS #40). Buat key di https://aistudio.google.com/apikey
LLM_API_KEY=
# Kosong = gemini-3.1-flash-lite. Ganti jika Google mengubah nama model (lihat ai.google.dev/gemini-api/docs/models).
LLM_MODEL=
# Kosong = https://generativelanguage.googleapis.com/v1beta
LLM_BASE_URL=
LLM_TIMEOUT_MS=4000
# Jeda antar permintaan saat `npm run eval` (batas tier gratis); naikkan jika sering 429.
LLM_EVAL_DELAY_MS=4500

# TTS neural (api/tts.ts). Azure Speech tier gratis F0: 0,5 juta karakter/bulan.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=id-ID-GadisNeural
